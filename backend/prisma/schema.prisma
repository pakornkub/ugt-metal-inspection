generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model BoxType {
  id   Int    @id @default(autoincrement()) @map("Id")
  name String @map("Name") @db.VarChar(50)

  @@map("BoxTypes")
}

model BoxInspection {
  id            BigInt   @id @default(autoincrement()) @map("Id")
  name          String   @map("Name") @db.NVarChar(100)
  lotNo         String   @map("LotNo") @db.VarChar(6)
  caseNo        String   @map("CaseNo") @db.VarChar(3)
  boxType       String   @map("BoxType") @db.VarChar(50)
  image1        String   @map("Image1") @db.VarChar(255)
  result1       String   @map("Result1") @db.VarChar(10)
  image2        String   @map("Image2") @db.VarChar(255)
  result2       String   @map("Result2") @db.VarChar(10)
  image3        String   @map("Image3") @db.VarChar(255)
  result3       String   @map("Result3") @db.VarChar(10)
  image4        String   @map("Image4") @db.VarChar(255)
  result4       String   @map("Result4") @db.VarChar(10)
  overallResult String   @map("OverallResult") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("CreatedAt") @db.DateTime2

  @@map("BoxInspections")
}
