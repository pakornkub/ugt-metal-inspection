# Root .env — read automatically by `docker compose` (docker-compose.yml/.dev.yml),
# NOT by `npm run dev` in frontend/ or backend/ (those use their own .env.local /
# .env — see backend/.env.example).
#
# Usage:
#   cp .env.example .env       # prod values → docker compose up
#   cp .env.example .env.dev   # dev values  → docker compose -f docker-compose.dev.yml --env-file .env.dev up
# Both .env and .env.dev are gitignored — never commit real values.

# Required — no default in docker-compose.yml, container won't start without it.
# Get this from admin/DBA (see docs/admin-handoff.md §4) — a SEPARATE database
# for prod vs dev, never point both at the same one.
DATABASE_URL="sqlserver://<host>:1433;database=UGT_MetalInspection;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false"
# .env.dev version: database=UGT_MetalInspection_DEV instead

# Host ports — defaults already match docker-compose.yml; only set these if
# admin assigns different ports (see docs/admin-handoff.md §1.4)
FRONTEND_PORT=3100
BACKEND_PORT=3101
AI_PORT=8000
# .env.dev defaults: FRONTEND_PORT=3110 BACKEND_PORT=3111 AI_PORT=8010

# basePath + public URL — baked into the frontend bundle at build time
# (NEXT_PUBLIC_*), only used by the Docker Build stage. Defaults already match
# what's in docker-compose.yml — only override if the domain/path changes.
NEXT_PUBLIC_BASE_PATH=/ugt-metal-inspection
NEXT_PUBLIC_APP_URL=https://ugtweb.ube.co.th/ugt-metal-inspection
# .env.dev defaults: /ugt-metal-inspection-dev

# Image tag — Jenkins sets this to BUILD_NUMBER automatically at deploy time.
# Leave unset for local `docker compose up --build` (falls back to "latest").
# TAG=

NODE_TLS_REJECT_UNAUTHORIZED=0
